{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "lib",
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
